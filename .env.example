# Postgres connection string. On Neon, use the *pooled* string (host contains "-pooler").
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# The key the assessment uses (X-API-Key). Long and random; keep it private.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# A second key that is embedded in the public booking page. It can do everything
# except POST /reset. Must be different from API_KEY.
WEB_KEY=
